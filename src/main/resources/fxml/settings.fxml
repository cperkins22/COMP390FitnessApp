<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" prefWidth="600" prefHeight="400"
            fx:controller="com.fitnessapp.SettingsController"
            style="-fx-background-color: #ADD8E6;"> <!-- light blue background -->

    <!-- Settings Title -->
    <VBox layoutX="20" layoutY="20" spacing="10">
        <Label text="Settings" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Main buttons area -->
    <VBox layoutX="20" layoutY="100" spacing="15" prefWidth="560">
        <!-- Add future settings options here -->
        <Label text="Settings options will be added here" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>

        <Region VBox.vgrow="ALWAYS" minHeight="150"/>

        <!-- Navigation buttons at bottom -->
        <Button text="Go Back" fx:id="backButton" prefWidth="200"
                onAction="#handleBackButton"/>

        <!-- Logout Button -->
        <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"
                prefWidth="200" prefHeight="40"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </VBox>

</AnchorPane>