<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.fitnessapp.SettingsController"
            prefWidth="600" prefHeight="400"
            style="-fx-background-color: #ADD8E6;">

    <VBox layoutX="20" layoutY="20" spacing="10">
        <Label text="Settings"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    </VBox>

    <VBox layoutX="20" layoutY="100" spacing="15" prefWidth="560">
        <Label text="Settings options will be added here"
               style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
        <Button text="DELETE ALL WORKOUTS FOR CURRENT USER" onAction="#deleteAllWorkouts"/>

        <Region VBox.vgrow="ALWAYS" minHeight="150"/>

        <Button text="Go Back"
                prefWidth="200"
                onAction="#handleBackButton"/>

        <Button text="Logout"
                prefWidth="200"
                prefHeight="40"
                onAction="#handleLogout"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </VBox>

</AnchorPane>