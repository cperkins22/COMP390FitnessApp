<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" prefWidth="600" prefHeight="400"
            fx:controller="com.fitnessapp.SettingsController"
            style="-fx-background-color: #ADD8E6;"> <!-- light blue background -->

    <!-- Calories display at the top -->
    <VBox layoutX="20" layoutY="20" spacing="10">
        <Label text="Settings" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    </VBox>

    <!-- Main buttons -->
    <VBox layoutX="20" layoutY="100" spacing="15">
        <Button text="Go Back" fx:id="backButton" prefWidth="200"
                onAction="#handleBackButton"/>
    </VBox>

</AnchorPane>