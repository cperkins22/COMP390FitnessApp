<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitnessapp.CreateWorkoutController"
            style="-fx-background-color: #ADD8E6;">
    <top>
        <VBox spacing="10" style="-fx-padding: 20;">
            <HBox prefHeight="0.0" prefWidth="780.0">
                <Label style="-fx-font-size: 22;" text="Create Workout"/>
                <Pane prefHeight="32.0" prefWidth="565.0"/>
                <Button alignment="CENTER_RIGHT" mnemonicParsing="false" text="Go Back"
                        onAction="#handleBackButton"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Workout Name:" />
                <TextField fx:id="workoutNameField" prefWidth="250" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5">
            <VBox spacing="10" style="-fx-padding: 20;" SplitPane.resizableWithParent="false">
                <Label style="-fx-font-size: 16;" text="Exercises" />
                <ListView fx:id="exerciseListView" prefHeight="400" />
                <HBox spacing="10">
                    <Button text="Add Exercise" onAction="#addExercise"/>
                    <Button text="Remove Exercise" onAction="#removeExercise"/>
                </HBox>
            </VBox>

            <VBox spacing="10" style="-fx-padding: 20;">
                <Label style="-fx-font-size: 16;" text="Exercise Details" />
                <TextArea fx:id="exerciseDescriptionArea" prefRowCount="6" promptText="Description..." />
                <Label style="-fx-font-size: 14;" text="Sets" />
                <TableView fx:id="setTable">
                    <columns>
                        <TableColumn fx:id="repsCol" text="Reps" />
                        <TableColumn fx:id="weightCol" text="Weight" />
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="Add Set" onAction="#addSet"/>
                    <Button text="Remove Set" onAction="#removeSet"/>
                </HBox>
            </VBox>
        </SplitPane>
    </center>

    <bottom>
        <Button prefHeight="44.0" prefWidth="116.0" style="-fx-padding: 12; -fx-font-size: 14;" text="Save Workout" BorderPane.alignment="CENTER"
        onAction="#saveWorkout"/>
    </bottom>
</BorderPane>
