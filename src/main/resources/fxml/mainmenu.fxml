<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" prefWidth="600" prefHeight="400"
            fx:controller="com.fitnessapp.MainMenuController"
            style="-fx-background-color: #ADD8E6;">

   <!-- Calories display at the top -->
   <VBox layoutX="20" layoutY="20" spacing="10">
      <Label text="Calories Remaining:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
      <Label text="-" fx:id="caloriesLabel" style="-fx-font-size: 20px;"/>
   </VBox>

   <!-- Main buttons -->
   <VBox layoutX="20" layoutY="100" spacing="15">
      <Button text="Workouts" fx:id="workoutButton" prefWidth="200"
              onAction="#handleTrackWorkoutButton"/>
      <Button text="Meals" fx:id="mealsButton" prefWidth="200"
              onAction="#handleTrackMealButton"/>
      <Button text="Personal Stats" fx:id="personalStatsButton" prefWidth="200"
              onAction="#handleProfileButton"/>
      <Button text="Settings" fx:id="settingsButton" prefWidth="200"
              onAction="#handleSettingsButton"/>
   </VBox>

</AnchorPane>